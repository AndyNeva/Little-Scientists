# .env.example — valores ficticios. Copiar a .env y completar sin subirlo al repositorio.
# Ninguna clave real debe aparecer en este archivo.

# ┌──────────────────────────────────────────────────────────────────────────┐
# │ INTERRUPTOR DE PROVEEDOR                                                 │
# │   cloudflare | gemini | mock                                             │
# │ El cambio no se refleja en la interfaz: solo afecta a quién genera.      │
# └──────────────────────────────────────────────────────────────────────────┘
IMAGE_PROVIDER=mock

# --- Cloudflare Workers AI (necesario si IMAGE_PROVIDER=cloudflare) ---
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
CLOUDFLARE_API_TOKEN=pon_aqui_tu_token
# Modelo validado en la Fase 0: admite imagen de entrada y está operativo.
# El prefijo @cf/ forma parte del nombre.
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# --- Gemini (necesario si IMAGE_PROVIDER=gemini) ---
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=pon_aqui_tu_clave
# Modelo de generación y edición de imágenes. Vacío = el validado.
GEMINI_MODEL=gemini-nano-banana-2.1
GEMINI_INPUT_MAX_SIDE_PX=1024

# --- Parámetros generales ---
REQUEST_TIMEOUT_SECONDS=60
MAX_UPLOAD_MB=8
MAX_NAME_LENGTH=20
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=0
LOG_LEVEL=INFO

# --- Preparación de la imagen enviada al proveedor ---
INPUT_MAX_SIDE_PX=1024
INPUT_JPEG_QUALITY=90
